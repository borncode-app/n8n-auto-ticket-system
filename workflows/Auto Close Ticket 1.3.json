        "operation": "executeQuery",
        "query": "UPDATE [YourDatabase].[dbo].[ticket]\nSET status = 'closed',\n    close_cause = $1,\n    close_reason = $2,\n    updated_date = GETDATE(),\n    updated_by = $3,\n    close_time_minute = CASE \n    WHEN DATEDIFF(MINUTE, created_date, GETDATE()) - 1 < 0 THEN 0 \n    ELSE DATEDIFF(MINUTE, created_date, GETDATE()) - 1 \nEND\nWHERE message_id = {{ $('Start').item.json.quotedMessageId }};",
        "options": {
          "queryReplacement": "={{ [\n  $('Start').item.json.clean_text.match(/(?:อาการ|ปัญหาอาการ)[\\s=:]*([\\s\\S]*?)(?=\\s*การแก้ไขปัญหา)/)?.[1].trim() ?? '',\n  $('Start').item.json.clean_text.match(/การแก้ไขปัญหา[\\s=:]*([\\s\\S]*?)(?=\\s*@|$)/)?.[1].trim() ?? '',\n  $('Match IT Team').first().json.userId\n] }}"
