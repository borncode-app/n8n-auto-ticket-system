        "mode": "runOnceForEachItem",
        "jsCode": "const i = $json;\nconst list = s => String(s || '').split(/[,;]/).map(x => x.trim()).filter(Boolean).map(a => ({ emailAddress: { address: a } }));\nconst isHtml = String(i.emailFormat || 'text').toLowerCase() === 'html';\nconst message = {\n  subject: i.subject || '',\n  body: { contentType: isHtml ? 'HTML' : 'Text', content: isHtml ? (i.html || i.text || '') : (i.text || '') },\n  toRecipients: list(i.toEmail)\n};\nif (i.ccEmail) message.ccRecipients = list(i.ccEmail);\nif (i.bccEmail) message.bccRecipients = list(i.bccEmail);\nif (i.replyTo) message.replyTo = list(i.replyTo);\nreturn { json: { payload: { message, saveToSentItems: true }, toEmail: i.toEmail, subject: i.subject } };"
      },
