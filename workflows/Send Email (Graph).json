        "jsCode": "const r = $json;\nconst req = $('Build Graph payload').item.json;\nconst err = r.error;\nconst ok = !err && r.statusCode === 202;\nreturn { json: {\n  success: ok,\n  status: ok ? 'sent' : 'failed',\n  statusCode: r.statusCode ?? err?.httpCode ?? null,\n  message: ok ? 'Email accepted by Microsoft Graph' : (typeof err === 'string' ? err : (err?.message || JSON.stringify(r.body || r))),\n  toEmail: req.toEmail,\n  subject: req.subject,\n  sentAt: $now.toISO()\n} };"
