            "emailFormat": "html",
            "html": "={{\n  \"<b>🔔 สรุปรายการ Ticket ตกค้าง ทั้งหมด \" + $json.data.length + \" รายการ</b><br>\" +\n  \"รบกวนให้ทางทีม IT Support ย้อนปิด Ticket ทางไลน์ผ่านข้อความเดิม<br><br>\" +\n  \"==================================================<br><br>\" +\n  $json.data.map((i, index) => {\n    \n    // จัดการวันที่และคำนวณวันย้อนหลัง\n    const now = DateTime.now();\n    const created = DateTime.fromJSDate(new Date(i.created_date));\nconst dateStr = created.setZone('utc').toFormat('dd/MM/yyyy HH:mm'); // ผลลัพธ์: 18/02/2026 13:23\n    \n    const diffDays = Math.floor(now.diff(created, 'days').days);\n    \n    // แสดงเฉพาะกรณีที่มากกว่า 0 วัน (ไม่เอา \"วันนี้\" และไม่เอาค่าติดลบ)\n    let daysDisplay = \"\";\n    if (diffDays > 0) {\n      daysDisplay = ` ( <strong style=\"color: red;\">${diffDays} วันที่ผ่านมา</strong> )`;\n    }\n    \n    // ดึงเฉพาะรายละเอียดปัญหา\n    const detail = i.clean_text.match(/ปัญหา\\s*\\s*([\\s\\S]*)/)?.[1]?.trim() || i.clean_text;\n    \n    return `<b>${index + 1}. ${i.subject}</b><br>\n    🏢 สาขา: ${i.branch_name} (${i.branch_company})<br>\n    🙋🏻 ผู้แจ้ง: ${i.created_by}<br>\n    👨🏻‍🔧 IT ผู้ดูแล: ${i.it_name || \"ไม่ระบุ\"}<br>\n    📅 แจ้งเมื่อ: ${dateStr}${daysDisplay}<br>\n    📝 รายละเอียด: ${detail}<br>\n    messageId: ${i.message_id}`;\n  }).join('<br><br>--------------------------------------------------<br><br>') + \n  \"<br><br>==================================================\"\n}}\n\n"
          },
